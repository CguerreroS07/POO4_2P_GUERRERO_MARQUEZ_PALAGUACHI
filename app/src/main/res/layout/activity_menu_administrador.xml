<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:visibility="visible"
    tools:context=".MenuAdministradorActivity">

    <LinearLayout
        android:id="@+id/AdministradorLayout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="1dp"
        android:layout_marginTop="1dp"
        android:layout_marginEnd="1dp"
        android:layout_marginBottom="1dp"
        android:orientation="vertical"
        android:padding="15sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="8dp">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/shape_circle_avatar"
                android:padding="8dp"
                android:src="@android:drawable/ic_menu_myplaces"
                app:tint="#FFFFFF" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bienvenido,"
                    android:textColor="#1E293B"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvNombreUsuarioHeader"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nombre Apellido"
                    android:textColor="#0B1B3D"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvTipoUsuarioHeader"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Participante"
                    android:textColor="#22C55E"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <ImageView
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:scaleType="fitCenter"
                android:src="@drawable/logo_mundial_2026" />
        </LinearLayout>

        <Button
            android:id="@+id/btnAdministrarPartidos"
            android:layout_width="match_parent"
            android:layout_height="60sp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:backgroundTint="@color/white"
            android:elevation="20sp"
            android:ellipsize="none"
            android:longClickable="false"
            android:text="Administrar partidos"
            android:textColor="#041B44"
            app:cornerRadius="12sp"
            app:strokeColor="#898686"
            app:strokeWidth="0.7sp" />

        <Button
            android:id="@+id/btnActualizarPuntajes"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:backgroundTint="@color/white"
            android:elevation="20sp"
            android:ellipsize="none"
            android:longClickable="false"
            android:text="Actualizar puntajes"
            android:textColor="#041B44"
            app:cornerRadius="12sp"
            app:strokeColor="#898686"
            app:strokeWidth="0.7sp"/>

        <Button
            android:id="@+id/btnSalirAdmin"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:backgroundTint="@color/white"
            android:elevation="20sp"
            android:ellipsize="none"
            android:longClickable="false"
            android:text="Salir"
            android:textColor="#041B44"
            app:cornerRadius="12sp"
            app:strokeColor="#898686"
            app:strokeWidth="0.7sp" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>