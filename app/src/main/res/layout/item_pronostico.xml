<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Encabezado: Fase y Estado -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tvFase"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Fase de grupos"
                android:textColor="#1E3A8A"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvEstadoBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:background="#E8F5E9"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:text="FINALIZADO"
                android:textColor="#2E7D32"
                android:textSize="9sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <!-- Detalle: Fecha, Hora, Estadio -->
        <TextView
            android:id="@+id/tvDetallePartido"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="📅 12 jun 2026   🕒 16:00   🏟️ Estadio Azteca"
            android:textColor="#666666"
            android:textSize="10sp" />

        <!-- Pronóstico vs Resultado Oficial -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Lado Izquierdo: Selección 1 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/imgBandera1"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@android:drawable/ic_menu_gallery" />

                <TextView
                    android:id="@+id/tvNombreSeleccion1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="España"
                    android:textColor="#000000"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Marcador Pronostocado -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tu pronóstico"
                    android:textColor="#666666"
                    android:textSize="9sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvGoles1"
                        android:layout_width="30dp"
                        android:layout_height="28dp"
                        android:background="#F0F0F0"
                        android:gravity="center"
                        android:text="2"
                        android:textColor="#000000"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="6dp"
                        android:text="-"
                        android:textColor="#666666" />

                    <TextView
                        android:id="@+id/tvGoles2"
                        android:layout_width="30dp"
                        android:layout_height="28dp"
                        android:background="#F0F0F0"
                        android:gravity="center"
                        android:text="1"
                        android:textColor="#000000"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- Lado Derecho: Selección 2 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/imgBandera2"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@android:drawable/ic_menu_gallery" />

                <TextView
                    android:id="@+id/tvNombreSeleccion2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Argentina"
                    android:textColor="#000000"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Separador Vertical -->
            <View
                android:id="@+id/dividerResultados"
                android:layout_width="1dp"
                android:layout_height="40dp"
                android:background="#E0E0E0" />

            <!-- Resultado Oficial y Puntos -->
            <LinearLayout
                android:id="@+id/layoutOficial"
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Resultado oficial"
                    android:textColor="#666666"
                    android:textSize="8sp" />

                <TextView
                    android:id="@+id/tvResultadoOficial"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="3 - 1"
                    android:textColor="#000000"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Puntos obtenidos"
                    android:textColor="#666666"
                    android:textSize="8sp" />

                <TextView
                    android:id="@+id/tvPuntosObtenidos"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1 pt"
                    android:textColor="#2E7D32"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>

        <!-- Mensaje de Estado / Banner inferior -->
        <TextView
            android:id="@+id/tvMensajeBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="#E8F5E9"
            android:gravity="center"
            android:padding="6dp"
            android:text="✔ ¡Acertaste el ganador! Obtuviste 1 punto."
            android:textColor="#2E7D32"
            android:textSize="10sp" />

    </LinearLayout>
</androidx.cardview.widget.CardView>